-- ============================================================
-- DATABASE
-- ============================================================
CREATE DATABASE IF NOT EXISTS bricms_db
CHARACTER SET utf8mb4
COLLATE utf8mb4_unicode_ci;

USE bricms_db;

-- ============================================================
-- 1. RESIDENT
-- ============================================================
CREATE TABLE resident (
  resident_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  first_name VARCHAR(80) NOT NULL,
  middle_name VARCHAR(80),
  last_name VARCHAR(80) NOT NULL,
  suffix VARCHAR(10),
  birth_date DATE,
  birth_place VARCHAR(150),
  gender ENUM('Male','Female','Non-binary'),
  civil_status ENUM('Single','Married','Widowed','Separated','Annulled','Common-Law'),
  citizenship ENUM('Filipino','Foreigner') DEFAULT 'Filipino',
  occupation VARCHAR(100),
  voter_status ENUM('Registered','Not Registered') DEFAULT 'Not Registered',
  mobile_number VARCHAR(15),
  emergency_contact VARCHAR(150),
  email VARCHAR(150) UNIQUE,
  password VARCHAR(255),
  is_verified TINYINT(1) DEFAULT 0,
  national_id VARCHAR(50) UNIQUE,
  sss_number VARCHAR(20) UNIQUE,
  gsis_number VARCHAR(20) UNIQUE,
  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP
);

-- ============================================================
-- 2. PROPERTY (formerly household)
-- ============================================================
CREATE TABLE property (
  property_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  property_head_id INT UNSIGNED NOT NULL,

  house_number VARCHAR(30),
  street VARCHAR(150),
  sitio_purok VARCHAR(100),

  tenure_status ENUM('Owner','Renter','Informal Settler','Caretaker') NOT NULL,

  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

  FOREIGN KEY (property_head_id)
    REFERENCES resident(resident_id)
);

-- ============================================================
-- 3. PROPERTY MEMBER
-- ============================================================
CREATE TABLE property_member (
  id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  property_id INT UNSIGNED NOT NULL,
  resident_id INT UNSIGNED NOT NULL,

  UNIQUE(property_id, resident_id),

  FOREIGN KEY (property_id) REFERENCES property(property_id) ON DELETE CASCADE,
  FOREIGN KEY (resident_id) REFERENCES resident(resident_id) ON DELETE CASCADE
);

-- ============================================================
-- 4. BARANGAY OFFICIAL
-- ============================================================
CREATE TABLE barangay_official (
  user_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  resident_id INT UNSIGNED NOT NULL,

  role_position ENUM(
    'Chairman','Secretary','Treasurer',
    'Councilor','Tanod','Clerk','Admin'
  ) NOT NULL,

  access_level ENUM('Admin','Editor','Viewer') DEFAULT 'Viewer',

  username VARCHAR(60) UNIQUE NOT NULL,
  hashed_password VARCHAR(255) NOT NULL,

  is_active TINYINT(1) DEFAULT 1,
  last_login TIMESTAMP NULL,

  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

  FOREIGN KEY (resident_id) REFERENCES resident(resident_id)
);

-- ============================================================
-- 5. DOCUMENT TYPE (NEW)
-- ============================================================
CREATE TABLE document_type (
  document_type_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  name VARCHAR(100) NOT NULL,

  is_payable TINYINT(1) DEFAULT 1,
  default_fee DECIMAL(10,2) DEFAULT 0.00
);

-- ============================================================
-- 6. SERVICE REQUEST
-- ============================================================
CREATE TABLE service_request (
  request_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  resident_id INT UNSIGNED NOT NULL,
  document_type_id INT UNSIGNED NOT NULL,

  purpose VARCHAR(200),

  status ENUM(
    'Pending','Processing','Ready for Pickup',
    'Released','Denied','Cancelled'
  ) DEFAULT 'Pending',

  date_requested DATE DEFAULT (CURDATE()),
  date_issued DATE,
  remarks TEXT,

  processed_by INT UNSIGNED,

  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,

  FOREIGN KEY (resident_id) REFERENCES resident(resident_id),
  FOREIGN KEY (document_type_id) REFERENCES document_type(document_type_id),
  FOREIGN KEY (processed_by) REFERENCES barangay_official(user_id)
);

-- ============================================================
-- 7. PAYMENT (CLEANED)
-- ============================================================
CREATE TABLE payment (
  payment_id INT UNSIGNED AUTO_INCREMENT PRIMARY KEY,
  request_id INT UNSIGNED NOT NULL,

  amount DECIMAL(10,2) NOT NULL,

  payment_method ENUM(
    'Cash','GCash','Maya','Bank Transfer','Other'
  ) DEFAULT 'Cash',

  payment_status ENUM('Pending','Paid','Refunded') DEFAULT 'Pending',

  reference_number VARCHAR(100),
  or_number VARCHAR(50),

  processed_by INT UNSIGNED,
  payment_date TIMESTAMP NULL,

  created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

  FOREIGN KEY (request_id) REFERENCES service_request(request_id),
  FOREIGN KEY (processed_by) REFERENCES barangay_official(user_id)
);
